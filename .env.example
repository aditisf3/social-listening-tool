# Copy this file to `.env` and fill in your credentials.
# NEVER commit your real .env file. It is gitignored.

# --- Reddit (required for Reddit connector) ---
# Create an app at https://www.reddit.com/prefs/apps (type: "script")
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=social-listening-tool/0.1 by your_username

# --- YouTube Data API v3 (required for YouTube connector) ---
# Get a key at https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# --- News API (required for News API connector) ---
# Get a key at https://newsapi.org/register
NEWSAPI_KEY=

# --- Mastodon (optional) ---
# Public timelines work WITHOUT a token. Set an instance to read from.
# A token is only needed for higher rate limits / private data.
MASTODON_INSTANCE=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# --- Bluesky (optional) ---
# Public search works WITHOUT credentials via the public AppView.
# Credentials only needed for authenticated endpoints.
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=

# --- GDELT ---
# No credentials required. The DOC 2.0 API is fully open.

# --- App settings ---
DATABASE_PATH=social_listening.db
